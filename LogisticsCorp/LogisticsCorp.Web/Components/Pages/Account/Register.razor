@page "/account/register"
@inherits ExtendedComponentBase
@layout AnonymousLayout

<div class="login-container">
    <MudCard Class="login-card">
        <MudCardContent>
            <div class="login-header">
                <div class="login-logo-placeholder">
                    <MudText Typo="Typo.h6" Class="logo-text">LOGO</MudText>
                </div>
                <MudText Typo="Typo.h4" Class="login-title">Create Account</MudText>
                <MudText Typo="Typo.body2" Class="login-subtitle">Sign up to get started with LogisticsCorp</MudText>
            </div>

            <EditForm Model="@Model" OnValidSubmit="@ValidSubmitHandler">
                <FluentValidator />

                <MudTextField @bind-Value="Model.Email"
                              For="@(() => Model.Email)"
                              Label="Email"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email"
                              Class="login-field" />

                <MudTextField @bind-Value="Model.FullName"
                              For="@(() => Model.FullName)"
                              Label="Full Name"
                              Variant="Variant.Outlined"
                              Class="login-field" />

                <MudTextField @bind-Value="Model.Address"
                              For="@(() => Model.Address)"
                              Label="Address"
                              Variant="Variant.Outlined"
                              Class="login-field" />

                <MudTextField @bind-Value="Model.PostalCode"
                              For="@(() => Model.PostalCode)"
                              Label="Postal Code"
                              Variant="Variant.Outlined"
                              Class="login-field" />

                <MudTextField @bind-Value="Model.City"
                              For="@(() => Model.City)"
                              Label="City"
                              Variant="Variant.Outlined"
                              Class="login-field" />

                <MudPasswordField @bind-Value="Model.Password"
                                  For="@(() => Model.Password)"
                                  Label="Password"
                                  Variant="Variant.Outlined"
                                  Class="login-field" />

                <MudPasswordField @bind-Value="Model.ConfirmPassword"
                                  For="@(() => Model.ConfirmPassword)"
                                  Label="Confirm Password"
                                  Variant="Variant.Outlined"
                                  Class="login-field" />

                <div class="login-actions">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               FullWidth="true"
                               Class="login-button"
                               ButtonType="ButtonType.Submit">
                        Sign Up
                    </MudButton>
                </div>
            </EditForm>

            <MudDivider Class="login-divider" />

            <div class="login-footer">
                <MudText Typo="Typo.body2" Class="footer-text">
                    Already have an account?
                    <MudLink Href="/account/login" Class="footer-link">Sign In</MudLink>
                </MudText>
            </div>
        </MudCardContent>
    </MudCard>
</div>
