@inherits ExtendedComponentBase

<PageTitle>@PageTitle</PageTitle>

<div class="form-container">
    <MudPaper Class="form-card" Elevation="0">
        <MudCardContent>
            <EditForm Model="ViewModel" OnInvalidSubmit="ValidSubmitHandler">
                <FluentValidator />

                <div class="form-section">
                    <MudText Typo="Typo.h6" Class="section-title">Personal Information</MudText>
                    <div class="form-grid">
                        <MudTextField @bind-Value="ViewModel.User.FullName"
                                      For="@(() => ViewModel.User.FullName)"
                                      Label="Full Name"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      Class="form-field" />

                        <MudTextField @bind-Value="ViewModel.User.Email"
                                      For="@(() => ViewModel.User.Email)"
                                      Label="Email"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Email"
                                      Required="true"
                                      Disabled="@(!IsCreate)"
                                      Class="form-field" />

                        <MudTextField @bind-Value="ViewModel.User.PhoneNumber"
                                      For="@(() => ViewModel.User.PhoneNumber)"
                                      Label="Phone Number"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      Class="form-field" />
                    </div>
                </div>

                <MudDivider Class="form-divider" />

                <div class="form-section">
                    <MudText Typo="Typo.h6" Class="section-title">Address Information</MudText>
                    <div class="form-grid">
                        <MudTextField @bind-Value="ViewModel.Address"
                                      For="@(() => ViewModel.Address)"
                                      Label="Address"
                                      Variant="Variant.Outlined"
                                      Class="form-field full-width" />

                        <MudTextField @bind-Value="ViewModel.City"
                                      For="@(() => ViewModel.City)"
                                      Label="City"
                                      Variant="Variant.Outlined"
                                      Class="form-field" />

                        <MudTextField @bind-Value="ViewModel.PostalCode"
                                      For="@(() => ViewModel.PostalCode)"
                                      Label="Postal Code"
                                      Variant="Variant.Outlined"
                                      Class="form-field" />
                    </div>
                </div>

                <MudDivider Class="form-divider" />

                <div class="form-section">
                    <MudText Typo="Typo.h6" Class="section-title">Account Status</MudText>
                    <div class="checkbox-group">
                        <MudCheckBox @bind-Value="ViewModel.User.IsActive"
                                     Color="Color.Primary"
                                     Class="form-checkbox">
                            <MudText Typo="Typo.body1" Class="checkbox-label">Active Account</MudText>
                        </MudCheckBox>
                        <MudText Typo="Typo.body2" Class="checkbox-hint">
                            Inactive clients cannot log in or access the system
                        </MudText>
                    </div>
                </div>

                <div class="form-actions">
                    <MudButton OnClick="@CancelHandler"
                               Variant="Variant.Outlined"
                               Color="Color.Default"
                               Size="Size.Large"
                               Class="action-button">
                        Cancel
                    </MudButton>
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               Class="action-button">
                        @(IsCreate ? "Create Client" : "Save Changes")
                    </MudButton>
                </div>
            </EditForm>
        </MudCardContent>
    </MudPaper>
</div>
