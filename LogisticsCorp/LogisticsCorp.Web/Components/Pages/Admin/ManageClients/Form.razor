@inherits ExtendedComponentBase

<PageTitle>@PageTitle</PageTitle>

<MudPaper Class="form-paper">
    <MudText Typo="Typo.h5" Class="mb-4">@PageTitle</MudText>

    <MudForm @ref="FormRef" Class="custom-form">

        <MudTextField @bind-Value="ViewModel.User.FullName" Label="First Name" Required="true" />
        <MudTextField @bind-Value="ViewModel.User.Email" Label="Email" Required="true" />
        <MudTextField @bind-Value="ViewModel.PhoneNumber" Label="Phone Number" Required="true" />
        <MudTextField @bind-Value="ViewModel.Address" Label="Address" />
        <MudTextField @bind-Value="ViewModel.City" Label="City" />
        <MudTextField @bind-Value="ViewModel.PostalCode" Label="Postal Code" />

        <MudInputLabel>@("Is Active")</MudInputLabel>
        <MudCheckBox @bind-Value="ViewModel.IsActive" Color="Color.Primary" />

        <MudButton OnClick="@SubmitHandler" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">
            Submit
        </MudButton>
        <MudButton OnClick="@CancelHandler" Variant="Variant.Text" Class="mt-4 ml-2">
            Cancel
        </MudButton>
    </MudForm>
</MudPaper>
