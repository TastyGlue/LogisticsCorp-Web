@inherits ExtendedComponentBase
@page "/company"


<PageTitle>Company Info</PageTitle>

<MudContainer Class="mt-8">
    @if (Company is null)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        
        <MudCard>

            <MudCardContent>
                <EditForm Model="@Company" OnValidSubmit="@ValidSubmitHandler">
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Company.Phone" Label="Phone" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Company.Email" Label="Email" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="Company.Adress" Label="Address" Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.h6" Class="mb-2">Weekly Schedule</MudText>

                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Company.MondaySchedule" Label="Monday" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Company.TuesdaySchedule" Label="Tuesday" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Company.WednesdaySchedule" Label="Wednesday" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Company.ThursdaySchedule" Label="Thursday" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Company.FridaySchedule" Label="Friday" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Company.SaturdaySchedule" Label="Saturday" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Company.SundaySchedule" Label="Sunday" Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-4" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"                          
                           ButtonType="ButtonType.Submit">                
                    Save Changes
                </MudButton>
                </EditForm>
            </MudCardContent>
        </MudCard>
    }
</MudContainer>
